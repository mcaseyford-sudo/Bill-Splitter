{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bill-splitter",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    // The built React app is served as static files from this same Worker.
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Requests to /api/* always go to our Worker code, never to static files.
    "run_worker_first": ["/api/*"]
  }
  // OPENAI_API_KEY will be added later as a Cloudflare secret
  // (`npx wrangler secret put OPENAI_API_KEY`), never in this file.
}
